# =========================================================
# 本地私有构建配置模板（复制为 .env.local 使用，切勿提交真实密钥！）
# .env.local 已被 .gitignore 严格忽略，仅在本地编译 Tauri 时由 build.rs 读取
# =========================================================

# 推荐生产架构：指向已开启鉴权与限流的反向代理（如 deploy/new-api Caddy 或 packages/ai-proxy）
# 不要直接填写上游大模型厂商的主 API Key，应当使用限定模型、限额、可随时吊销的子令牌或代理访问令牌
MNK_EMBED_AI_BASE_URL=http://127.0.0.1:8787
MNK_EMBED_AI_API_KEY=
MNK_EMBED_AI_MODEL=gemini-3.8-flash-high
