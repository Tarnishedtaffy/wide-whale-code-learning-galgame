# ============================================
#  通用 .gitignore — Galgame 代码学习
# ============================================

# ---- 操作系统 ----
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- Ren'Py（Galgame 引擎）----
game/cache/
game/saves/
log.txt
errors.txt
traceback.txt
*.rpyc
*.rpymc
*.rpyb

# ---- Node.js ----
node_modules/
dist/
build/

# ---- 密钥 / 本地配置（千万别提交）----
.env
.env.*
!.env.example
!.env.local.example
*.key
*.pem
secrets.*

# ---- new-api 运行数据（含明文上游 key，绝不提交）----
deploy/new-api/data/
*.db
*.db-journal
*.log

# ---- 审议/会话材料（含上游地址，不进仓库）----
# 这两处曾把中转地址带进公开仓库，忽略以防自动提交再次纳入。
# 需要给同事看时走私有渠道单独发送，不要提交。
exports/
.uploads/

# ---- 大文件提醒 ----
# GitHub 单文件上限 100MB，超过会被拒收。
# 游戏素材（视频/语音/高清图）请走 Git LFS：
#   git lfs track "*.psd" "*.wav" "*.mp4"

# Caddy 静态目录（部署时由 start.sh 生成，不进仓库）
deploy/new-api/site/

# ---- Monorepo / Vite / TypeScript ----
packages/*/dist/
*.tsbuildinfo
.turbo/

# ---- Tauri / Rust / Android ----
src-tauri/target/
src-tauri/WixTools/
src-tauri/gen/schemas/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/**/build/
src-tauri/gen/android/local.properties

