{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnk Study Loop",
  "version": "1.0.0",
  "identifier": "com.widewhale.mnkstudyloop",
  "build": {
    "beforeDevCommand": "pnpm --filter @mnk/app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @mnk/shared build && pnpm --filter @mnk/app build",
    "frontendDist": "../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mnk Study Loop",
        "width": 412,
        "height": 880,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
