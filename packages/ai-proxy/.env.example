# Mnk Study Loop AI Proxy 环境变量示例（切勿提交真实密钥）
PORT=8787
HOST=127.0.0.1

# 主渠道：智谱 GLM（密钥仅保存在服务端，绝不下发给客户端）
ZHIPU_KEY=
ZHIPU_MODEL=glm-4.7-flash

# 备用/中转渠道（可选，请务必在 new-api 后台限制模型白名单与有限额度）
RELAY_URL=
RELAY_KEY=
RELAY_MODEL=gemini-3.8-flash-high

# 客户端访问鉴权令牌（强烈建议公网部署时开启；客户端仅持有此可随时更换的访问令牌，不持有上游 sk- 密钥）
PROXY_ACCESS_TOKEN=

# 单 IP 每分钟最大请求数与单次最大输出 Token 上限（防止脚本刷量盗刷额度）
RATE_LIMIT_RPM=24
MAX_TOKENS_CAP=2048

# 允许客户端指定的模型白名单（逗号分隔，留空则强制使用渠道预设模型）
ALLOWED_MODELS=mnk-chat,gemini-3.8-flash-high,glm-4.7-flash

# 允许跨域访问的额外前端域名（逗号分隔，默认已内置 Tauri WebView 与 localhost:5173）
ALLOWED_ORIGINS=
