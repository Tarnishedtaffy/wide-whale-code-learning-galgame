# 复制为 .env 后填写；.env 已被 .gitignore 排除，不要提交
# 域名（Caddy 自动申请证书用）
DOMAIN=study.example.com
# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com
# 只放行你的站点来源，不要用 *
ALLOW_ORIGIN=https://study.example.com
# 在 new-api 面板创建专用令牌，只允许 mnk-chat，并设置有限额度（不要勾无限额度）
NEWAPI_TOKEN=
# 整站登录账号；不要使用模型令牌作为登录密码
SITE_USER=learner
# 用 docker run --rm -it caddy:2-alpine caddy hash-password 交互生成 bcrypt。
# 将结果放进下面的单引号内，防止 shell / Compose 展开哈希中的 $。
SITE_PASSWORD_HASH=''
# 随机字符串，至少 32 位（可用 openssl rand -hex 32 生成）
SESSION_SECRET=
# 留空则使用内置 SQLite（./data/one-api.db）
SQL_DSN=
